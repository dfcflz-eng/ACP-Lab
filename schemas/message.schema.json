{
  "$schema": "http://json-schema.org/draft-07/schema#",

  "title": "ACP Message",

  "type": "object",

  "properties": {

    "type": {
      "type": "string",
      "enum": [
        "HELLO",
        "CAPABILITY",
        "REQUEST",
        "RESPONSE"
      ]
    },

    "protocol": {
      "type": "string"
    },

    "from": {
      "type": "string"
    },

    "to": {
      "type": "string"
    },

    "intent": {
      "type": "string"
    },

    "content": {
      "type": "string"
    }

  },

  "required": [
    "type",
    "protocol",
    "from",
    "content"
  ]
}
